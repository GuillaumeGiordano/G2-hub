# G2 Hub — configuration of ONE instance (shared G2 WebDev instance, or a copy delivered to a
# client). Everything instance-specific lives here; nothing is hard-coded. Copy to `.env`.

# ── Instance ────────────────────────────────────────────────────────────────────────────────
# Name shown in the console (title, login screen, 2FA issuer).
HUB_NAME="G2 Hub"
# Public URL of the console (Better Auth base URL). Dev falls back to http://localhost:5180.
ORIGIN=

# ── Database ────────────────────────────────────────────────────────────────────────────────
# Use 127.0.0.1, not localhost: on Windows the pg driver may resolve localhost to IPv6 (::1).
DATABASE_URL="postgresql://g2hub:devpassword@127.0.0.1:5433/g2hub"

# ── Authentication ──────────────────────────────────────────────────────────────────────────
# Random 32+ char secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# First superadmin, created by `pnpm hub:install` (change the password after the first login).
ADMIN_EMAIL="admin@g2hub.local"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Super Admin"

# ── Object storage (S3-compatible) ──────────────────────────────────────────────────────────
# Dev: the MinIO of docker-compose.yml. Prod: Infomaniak Object Storage
# (endpoint https://s3.pub1.infomaniak.cloud, region us-east-1, EC2 credentials).
# A delivered copy points these at the client's own bucket — no code change.
S3_ENDPOINT="http://127.0.0.1:9100"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Anonymously readable (files served straight to client sites).
S3_BUCKET_PUBLIC="g2hub-public"
# Never readable without a short-lived signed link.
S3_BUCKET_PRIVATE="g2hub-private"
# Public base URL of the public bucket (files are served straight from the storage, never through
# the hub). Dev: MinIO path-style. Prod: e.g. https://s3.pub1.infomaniak.cloud/<public bucket>
# (or a CDN / custom domain in front of it).
S3_PUBLIC_URL="http://127.0.0.1:9100/g2hub-public"

# ── E-mails (application users: invitations, password resets) ──────────────────────────────
# Dev: the Mailpit of docker-compose.yml (inbox http://localhost:8125). Prod: an Infomaniak
# mailbox (mail.infomaniak.com, port 465, SMTP_SECURE=true). Empty SMTP_HOST = e-mails disabled.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1125"
# true = TLS from the start (port 465); false = plain or STARTTLS (587, 1025).
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASSWORD=
# Sender of every e-mail ("Name <address>").
MAIL_FROM="G2 Hub <no-reply@g2hub.local>"

# ── Media processing ────────────────────────────────────────────────────────────────────────
# ffmpeg / ffprobe binaries (videos → H.264 1080p + poster). Default: found on the PATH
# (apt install ffmpeg on the VPS, scoop install ffmpeg on Windows).
FFMPEG_PATH=
FFPROBE_PATH=

# ── Demo landing (apps/demo-landing) ────────────────────────────────────────────────────────
# A client site reading its gallery from the hub with a PUBLISHABLE key (create it in the console:
# Applications › <app> › Clés API). The folder path is case-insensitive.
DEMO_HUB_URL="http://localhost:5180"
DEMO_HUB_KEY=
DEMO_GALLERY_PATH="Galerie"
# The demo site's own admin (/admin) uploads photos with a SECRET key (server-side only), and is
# protected by this password (HTTP Basic, any user name). Empty = admin disabled.
DEMO_HUB_SECRET_KEY=
DEMO_ADMIN_PASSWORD=

# ── Demo portal (apps/demo-portal) ──────────────────────────────────────────────────────────
# A client portal using « Se connecter avec G2 Hub » (OIDC). In the console: Applications › <app>
# › Connexion → activate, copy the client secret, and add the return URL
# http://localhost:5191/auth/callback. The hub address is DEMO_HUB_URL above.
DEMO_PORTAL_URL="http://localhost:5191"
DEMO_PORTAL_CLIENT_ID=
DEMO_PORTAL_CLIENT_SECRET=
