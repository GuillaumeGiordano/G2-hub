// G2 Hub — data model. Multi-tenant: every client datum hangs off an Organization and is always
// queried scoped by it (see DECISIONS.md §13). Folders and files arrive in step 2.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

/// A client of the instance (billed monthly outside the hub). Owns members and applications.
model Organization {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  /// Storage quota of the plan, in bytes — 1 GB, 5 GB or 20 GB (DECISIONS.md §10).
  quotaBytes     BigInt   @default(1073741824)
  /// Offer: false = « Accès » (user management only), true = « Accès + Stockage » (§12).
  storageEnabled Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships  Membership[]
  applications Application[]
  folders      Folder[]
  files        StoredFile[]
  /// Sessions currently working in this organization (cleared if it is deleted).
  sessions     Session[]
}

/// A console account's rights inside ONE organization (an account may belong to several).
enum OrgRole {
  /// Everything in the organization: members, roles, applications (and keys, files).
  OWNER
  /// Create / rename / delete folders and files.
  EDITOR
  /// Read and download.
  VIEWER
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

/// A client's site / portal / portfolio plugged into the hub (API keys arrive in step 3).
model Application {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// URL-friendly id, unique within the organization.
  slug           String
  /// Origins (scheme + host + port) allowed to call the API from a browser — CORS (§3).
  allowedOrigins String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  folders Folder[]

  @@unique([organizationId, slug])
}

// ─── Storage ─────────────────────────────────────────────────────────────────

/// Who may read the files of a folder (DECISIONS.md §7). Each visibility lives in its own bucket.
enum Visibility {
  /// Anonymously readable by direct URL (images, videos, PDFs shown on a client site).
  PUBLIC
  /// Never readable without a short-lived signed link (personal files).
  PRIVATE
}

/// A folder of an application. Folders nest; a subfolder always has its parent's visibility.
model Folder {
  id             String       @id @default(uuid())
  /// Denormalized from the application: every query is scoped by organization (§13).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// null = a root folder of the application.
  parentId       String?
  parent         Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Folder[]     @relation("FolderTree")
  files          StoredFile[]
  name           String
  visibility     Visibility
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, applicationId, parentId])
}

enum FileKind {
  IMAGE
  VIDEO
  PDF
}

/// Lifecycle of a stored file (DECISIONS.md §5): the browser uploads the original straight to S3
/// (UPLOADING), the hub checks it and builds the processed versions (PROCESSING), then only those
/// are kept (READY). FAILED keeps the row so the member sees what went wrong and can delete it.
enum FileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

/// A file of a folder. Only the PROCESSED versions are kept (WebP widths for an image, 1080p + poster
/// for a video, the PDF itself) — the original is deleted once processed (§5).
model StoredFile {
  id             String       @id @default(uuid())
  /// Denormalized from the folder: every query is scoped by organization (§13).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  folderId       String
  folder         Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// Display name (the uploaded file's name).
  name           String
  kind           FileKind
  status         FileStatus   @default(UPLOADING)
  /// The bucket the processed versions live in — copied from the folder at upload (§7).
  visibility     Visibility
  /// Object key prefix of the processed versions: `orgs/{org}/apps/{app}/files/{id}/`.
  storagePrefix  String
  /// Temporary key of the uploaded original (private bucket), null once processed.
  originalKey    String?
  /// The processed versions: [{ name, key, contentType, bytes, width?, height? }].
  variants       Json         @default("[]")
  /// Counts toward the organization's quota: the DECLARED size while uploading / processing (a
  /// reservation), then the real total of the processed versions (§10).
  bytes          BigInt
  width          Int?
  height         Int?
  /// Why processing failed (shown to the member).
  error          String?
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  jobs           MediaJob[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, folderId])
  @@index([organizationId, status])
}

enum MediaJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Background processing queue (DECISIONS.md §5): a video is transcoded outside the HTTP request.
/// Database-backed — nothing extra to run on the VPS, and queued work survives a restart.
model MediaJob {
  id         String         @id @default(uuid())
  fileId     String
  file       StoredFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status     MediaJobStatus @default(QUEUED)
  attempts   Int            @default(0)
  lastError  String?
  createdAt  DateTime       @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

// ─── Authentication (Better Auth) ────────────────────────────────────────────
// Better Auth manages these tables (core + twoFactor plugin).

/// A console account. `role` is the INSTANCE-level role: `superadmin` (the operator, sees every
/// organization) or `member` (a client's account — its rights inside an organization come from
/// its membership, step 1).
model User {
  id               String   @id
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  role             String   @default("member")
  /// Whether two-factor authentication is enabled (Better Auth twoFactor plugin).
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]
  memberships Membership[]
  uploads     StoredFile[]

  @@map("user")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("twoFactor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The organization the console is currently working in. Always set server-side after checking
  /// the membership (never trusted from the browser) — DECISIONS.md §13.
  activeOrganizationId String?
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
