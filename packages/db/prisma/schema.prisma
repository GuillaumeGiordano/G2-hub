// G2 Hub — data model. Multi-tenant: every client datum hangs off an Organization and is always
// queried scoped by it (see DECISIONS.md §13). Folders and files arrive in step 2.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

/// A client of the instance (billed monthly outside the hub). Owns members and applications.
enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  /// Storage quota of the plan, in bytes — 1 GB, 5 GB or 20 GB (DECISIONS.md §10).
  quotaBytes     BigInt   @default(1073741824)
  /// Offer: false = « Accès » (user management only), true = « Accès + Stockage » (§12).
  storageEnabled Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Logo: key of a WebP in the PUBLIC bucket (`organizations/<id>/logo-<uuid>.webp`). The legal
  /// and billing profile lives in the management tool, g2-erp (DECISIONS.md §31).
  logoKey String?
  /// SUSPENDED is informative for now (nothing blocked); later driven by g2-erp's active contract.
  status  OrganizationStatus @default(ACTIVE)

  memberships      Membership[]
  applications     Application[]
  folders          Folder[]
  files            StoredFile[]
  apiKeys          ApiKey[]
  appUsers         AppUser[]
  /// Platform tools enabled for this organization (DECISIONS.md §38).
  tools            OrganizationTool[]
  /// « Se connecter avec G2 Hub » to a tool, for this organization (§38).
  oidcAuthCodes    OidcAuthCode[]
  oidcAccessTokens OidcAccessToken[]
}

/// A console account's rights inside ONE organization (an account may belong to several).
/// Every member is an « Admin » (DECISIONS.md §26); finer roles live in the applications.
enum OrgRole {
  /// Everything in the organization: members, applications (and keys, users, files).
  OWNER
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

/// A client's site / portal / portfolio plugged into the hub (API keys arrive in step 3).
/// Whether the admins of OTHER organizations may sign in to an application of the platform
/// (DECISIONS.md §38). Set by the superadmin.
enum PlatformAccess {
  /// A client's application: only the Admins of its own organization (§26).
  NONE
  /// The client portal: every Admin of any organization, as `client`, at the account level.
  ALL_ADMINS
  /// A tool: an Admin enters FOR one organization, if the tool is enabled for it.
  PER_ORGANIZATION
}

model Application {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  /// URL-friendly id, unique within the organization.
  slug            String
  /// Origins (scheme + host + port) allowed to call the API from a browser — CORS (§3).
  allowedOrigins  String[]       @default([])
  /// « Se connecter avec G2 Hub » (OIDC, DECISIONS.md §25): on when a client secret exists. The
  /// client_id is the application id; only the SHA-256 of the secret is stored.
  ssoSecretHash   String?
  /// First characters of the client secret, to recognize it ("g2_sso_8fK2…").
  ssoSecretPrefix String?
  /// Exact URLs the hub may send a user back to after sign-in (no wildcard).
  ssoRedirectUris String[]       @default([])
  /// Application of the platform (§38): who outside its organization may sign in.
  platformAccess  PlatformAccess @default(NONE)
  /// Where the « Outils » launcher opens it (a tool also receives `?organization=<id>`).
  homeUrl         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  folders      Folder[]
  apiKeys      ApiKey[]
  appUsers     AppUser[]
  authCodes    OidcAuthCode[]
  accessTokens OidcAccessToken[]
  /// Organizations this tool is enabled for (PER_ORGANIZATION, §38).
  enabledFor   OrganizationTool[]

  @@unique([organizationId, slug])
}

/// A tool of the platform enabled for an organization (DECISIONS.md §38), by the superadmin — later
/// by the management tool (an order / contract). Free for now.
model OrganizationTool {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  enabledAt      DateTime     @default(now())

  @@id([organizationId, applicationId])
  @@index([applicationId])
}

// ─── Storage ─────────────────────────────────────────────────────────────────

/// Who may read the files of a folder (DECISIONS.md §7). Each visibility lives in its own bucket.
enum Visibility {
  /// Anonymously readable by direct URL (images, videos, PDFs shown on a client site).
  PUBLIC
  /// Never readable without a short-lived signed link (personal files).
  PRIVATE
}

/// A folder of an application. Folders nest; a subfolder always has its parent's visibility.
/// What an organization's Admin may do with a folder its SITE relies on (DECISIONS.md §37). The
/// superadmin is never restricted, and sets it.
enum FolderLock {
  /// Free: the Admin renames, deletes, creates subfolders and manages the files.
  NONE
  /// The site reads it: no rename, no delete; the files (and subfolders) stay manageable.
  LOCKED
  /// Content fixed too: the Admin only looks (documents provided by G2 Webdev…).
  READ_ONLY
}

model Folder {
  id             String       @id @default(uuid())
  /// Denormalized from the application: every query is scoped by organization (§13).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// null = a root folder of the application.
  parentId       String?
  parent         Folder?      @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Folder[]     @relation("FolderTree")
  files          StoredFile[]
  name           String
  visibility     Visibility
  /// A folder the superadmin creates is LOCKED by default (§37).
  lock           FolderLock   @default(NONE)
  /// Set = the personal space of this application user (DECISIONS.md §28): one PUBLIC and one
  /// PRIVATE root per user (partial unique index, see the migration), created on first use, kept
  /// out of the site's tree (console, /folders, /media). Its files are purged with the user.
  ownerAppUserId String?
  ownerAppUser   AppUser?     @relation(fields: [ownerAppUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, applicationId, parentId])
  @@index([ownerAppUserId])
}

/// Where a file was uploaded from (DECISIONS.md §22). A file sent by a client SITE (through the API)
/// is only deleted from that site: the console shows it read-only, so the site's database never
/// points to a vanished file.
enum FileSource {
  CONSOLE
  API
}

enum FileKind {
  IMAGE
  VIDEO
  PDF
}

/// Lifecycle of a stored file (DECISIONS.md §5): the browser uploads the original straight to S3
/// (UPLOADING), the hub checks it and builds the processed versions (PROCESSING), then only those
/// are kept (READY). FAILED keeps the row so the member sees what went wrong and can delete it.
enum FileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

/// A file of a folder. Only the PROCESSED versions are kept (WebP widths for an image, 1080p + poster
/// for a video, the PDF itself) — the original is deleted once processed (§5).
model StoredFile {
  id             String       @id @default(uuid())
  /// Denormalized from the folder: every query is scoped by organization (§13).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  folderId       String
  folder         Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  /// Display name (the uploaded file's name).
  name           String
  /// Alternative text for an image (accessibility, SEO) — editable in the media library (§22).
  alt            String?
  /// Caption shown under the media on a site — editable in the media library (§22).
  caption        String?
  source         FileSource   @default(CONSOLE)
  /// The API key a site uploaded it with (null when uploaded from the console).
  apiKeyId       String?
  apiKey         ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  kind           FileKind
  status         FileStatus   @default(UPLOADING)
  /// The bucket the processed versions live in — copied from the folder at upload (§7).
  visibility     Visibility
  /// The application user whose personal space holds the file — copied from the folder at upload
  /// (§28). null = a file of the site.
  ownerAppUserId String?
  ownerAppUser   AppUser?     @relation(fields: [ownerAppUserId], references: [id], onDelete: Cascade)
  /// Object key prefix of the processed versions: `orgs/{org}/apps/{app}/files/{id}/`.
  storagePrefix  String
  /// Temporary key of the uploaded original (private bucket), null once processed.
  originalKey    String?
  /// The processed versions: [{ name, key, contentType, bytes, width?, height? }].
  variants       Json         @default("[]")
  /// Counts toward the organization's quota: the DECLARED size while uploading / processing (a
  /// reservation), then the real total of the processed versions (§10).
  bytes          BigInt
  width          Int?
  height         Int?
  /// Why processing failed (shown to the member).
  error          String?
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  jobs           MediaJob[]
  pins           FilePin[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, folderId])
  @@index([organizationId, status])
  @@index([ownerAppUserId])
}

/// A site uses this file (e.g. in a product card): while at least one pin exists, the file cannot
/// be deleted — from the console or the API (DECISIONS.md §23). `ref` is the site's own label of
/// the use ("product:42"), so two cards sharing a photo hold two pins and freeing one keeps it
/// protected. Scoped through the file (organization + application).
model FilePin {
  id        String     @id @default(uuid())
  fileId    String
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  ref       String
  createdAt DateTime   @default(now())

  @@unique([fileId, ref])
}

// ─── API ─────────────────────────────────────────────────────────────────────

/// What an API key may do (DECISIONS.md §19).
enum ApiKeyKind {
  /// Read-only, PUBLIC folders only; usable from a browser, restricted to the app's origins.
  PUBLISHABLE
  /// Server-to-server only (refused when sent by a browser); reads everything (private files
  /// through signed links) and, from step 3c, writes.
  SECRET
}

/// An application's API key. Only its SHA-256 hash is stored: the full key is shown ONCE.
model ApiKey {
  id             String       @id @default(uuid())
  /// Denormalized from the application: every query is scoped by organization (§13).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind           ApiKeyKind
  /// Label given by the owner ("Site vitrine", "Back-office du portail"…).
  name           String
  /// First characters of the key, shown in lists to recognize it ("g2_pub_8fK2…").
  prefix         String
  /// SHA-256 (hex) of the full key — enough for a long random key (no password to brute-force).
  hash           String       @unique
  /// Last authenticated call (refreshed at most every few minutes).
  lastUsedAt     DateTime?
  /// Set when revoked: the key stops working at once, the row stays for the audit.
  revokedAt      DateTime?
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  /// Files a site uploaded with this key.
  files StoredFile[]

  @@index([organizationId, applicationId])
}

enum MediaJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Background processing queue (DECISIONS.md §5): a video is transcoded outside the HTTP request.
/// Database-backed — nothing extra to run on the VPS, and queued work survives a restart.
model MediaJob {
  id         String         @id @default(uuid())
  fileId     String
  file       StoredFile     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  status     MediaJobStatus @default(QUEUED)
  attempts   Int            @default(0)
  lastError  String?
  createdAt  DateTime       @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

// ─── Authentication (Better Auth) ────────────────────────────────────────────
// Better Auth manages these tables (core + twoFactor plugin).

/// A console account. `role` is the INSTANCE-level role: `superadmin` (the operator, sees every
/// organization) or `member` (a client's account — its rights inside an organization come from
/// its membership, step 1).
model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  role             String    @default("member")
  /// Whether two-factor authentication is enabled (Better Auth twoFactor plugin).
  twoFactorEnabled Boolean   @default(false)
  /// Set when an Admin (or the superadmin) disables the account: no new session, existing ones
  /// revoked; the account and its memberships are kept (DECISIONS.md §30).
  disabledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  memberships      Membership[]
  uploads          StoredFile[]
  apiKeys          ApiKey[]
  /// Application users this member invited.
  invitedAppUsers  AppUser[]
  /// « Se connecter avec G2 Hub » as an Admin of the application's organization (§26).
  oidcAuthCodes    OidcAuthCode[]
  oidcAccessTokens OidcAccessToken[]

  @@map("user")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@map("twoFactor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Application users (portal end users) — DECISIONS.md §24 ─────────────────────────────────

/// Roles, by importance: SUPER_USER › USER › GUEST (§26) — sent to the portal in the `role` claim;
/// the portal decides what each role may do.
enum AppUserRole {
  SUPER_USER
  USER
  GUEST
}

/// Someone who signs in to a client's PORTAL (not to the console): an account isolated in ONE
/// application — the same e-mail may have separate accounts in two applications. Created by
/// invitation; never able to sign in to the console (separate table from Better Auth's `user`).
model AppUser {
  id             String       @id @default(uuid())
  /// Denormalized from the application: every query is scoped by organization (§13).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Lowercased and trimmed.
  email          String
  name           String
  role           AppUserRole  @default(USER)
  /// scrypt hash (`scrypt$N$r$p$salt$hash`); null until the invitation is accepted.
  passwordHash   String?
  /// Set when disabled by the organization: links and sign-in refused, the account is kept.
  disabledAt     DateTime?
  lastLoginAt    DateTime?
  invitedById    String?
  invitedBy      User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tokens       AppUserToken[]
  folders      Folder[]
  files        StoredFile[]
  authCodes    OidcAuthCode[]
  accessTokens OidcAccessToken[]

  @@unique([applicationId, email])
  @@index([organizationId, applicationId])
}

enum AppUserTokenPurpose {
  /// Sent at invitation: choose a password and activate the account (7 days).
  INVITATION
  /// « Mot de passe oublié » (1 hour).
  PASSWORD_RESET
}

/// A single-use link sent by e-mail. Only the SHA-256 of the random token is stored.
model AppUserToken {
  id        String              @id @default(uuid())
  appUserId String
  appUser   AppUser             @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  purpose   AppUserTokenPurpose
  hash      String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([appUserId, purpose])
}

// ─── « Se connecter avec G2 Hub » (OIDC provider) — DECISIONS.md §25 ─────────────────────────

/// A single-use authorization code (60 s), exchanged by the portal's server for tokens. PKCE: the
/// code is useless without the verifier matching `codeChallenge`. Only its SHA-256 is stored.
/// Issued to EXACTLY ONE of: an application user, or a console member who is an Admin of the
/// application's organization (§26) — enforced by a CHECK constraint (see the migration).
model OidcAuthCode {
  id             String        @id @default(uuid())
  hash           String        @unique
  applicationId  String
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  appUserId      String?
  appUser        AppUser?      @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The organization a console member entered a TOOL for (§38): the tool sees only it.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Must be sent again, identical, with the code.
  redirectUri    String
  /// base64url(SHA-256(code_verifier)) — S256 only.
  codeChallenge  String
  nonce          String?
  scope          String
  /// When the user typed their password (`auth_time` claim).
  authTime       DateTime
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([expiresAt])
}

/// An access token (opaque, 1 h) for /oauth/userinfo — and, later, the API on the user's behalf.
/// Stored hashed, so disabling or deleting the user revokes it at once. Same holder rule as the
/// codes: exactly one of `appUserId` / `userId`.
model OidcAccessToken {
  id             String        @id @default(uuid())
  hash           String        @unique
  applicationId  String
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  appUserId      String?
  appUser        AppUser?      @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The organization a console member entered a TOOL for (§38): the tool sees only it.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String
  expiresAt      DateTime
  createdAt      DateTime      @default(now())

  @@index([appUserId])
  @@index([userId])
  @@index([expiresAt])
}

/// The instance's key pair signing the ID tokens (RS256), generated at first use. Portals verify
/// signatures with the public half, published at /oauth/jwks.
model OidcSigningKey {
  /// Key id (`kid` in the token header) — lets a future key rotation publish several keys.
  kid           String   @id
  publicJwk     Json
  privateKeyPem String
  createdAt     DateTime @default(now())
}
