# Copy to bruno/.env (never committed) and fill in from the console:
# Applications > <app> > Cles API (keys) and > Connexion (client id / secret).
HUB_KEY=
HUB_SECRET_KEY=
HUB_CLIENT_ID=
HUB_CLIENT_SECRET=
# INTERNAL_API_TOKEN of the hub's .env (internal API only).
INTERNAL_API_TOKEN=

# Production instance (environment « Production »): keys of a TEST application of
# https://hub.g2webdev.fr — never a client's application.
PROD_HUB_KEY=
PROD_HUB_SECRET_KEY=
PROD_HUB_CLIENT_ID=
PROD_HUB_CLIENT_SECRET=
PROD_INTERNAL_API_TOKEN=
