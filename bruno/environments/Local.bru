vars {
  hubUrl: http://localhost:5180
  galleryPath: Galerie
  portalCallback: http://localhost:5191/auth/callback
  publicKey: {{process.env.HUB_KEY}}
  secretKey: {{process.env.HUB_SECRET_KEY}}
  clientId: {{process.env.HUB_CLIENT_ID}}
  clientSecret: {{process.env.HUB_CLIENT_SECRET}}
  internalToken: {{process.env.INTERNAL_API_TOKEN}}
}
