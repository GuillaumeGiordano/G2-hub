vars {
  hubUrl: https://hub.g2webdev.fr
  galleryPath: Galerie
  portalCallback: http://localhost:5191/auth/callback
  publicKey: {{process.env.PROD_HUB_KEY}}
  secretKey: {{process.env.PROD_HUB_SECRET_KEY}}
  clientId: {{process.env.PROD_HUB_CLIENT_ID}}
  clientSecret: {{process.env.PROD_HUB_CLIENT_SECRET}}
  internalToken: {{process.env.PROD_INTERNAL_API_TOKEN}}
}
