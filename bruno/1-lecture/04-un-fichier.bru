meta {
  name: Un fichier
  type: http
  seq: 4
}

get {
  url: {{hubUrl}}/api/v1/files/{{galleryFileId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{publicKey}}
}

script:pre-request {
  // An empty gallery gives no id to read: skip instead of failing on « files/ ».
  if (!bru.getVar("galleryFileId")) bru.runner.skipRequest();
}

tests {
  test("200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  GET /api/v1/files/:id. Run « Fichiers de la galerie » first (sets galleryFileId).
}
