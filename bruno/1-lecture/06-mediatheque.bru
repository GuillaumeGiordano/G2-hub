meta {
  name: Médiathèque filtrée par dossier
  type: http
  seq: 6
}

get {
  url: {{hubUrl}}/api/v1/media?kind=IMAGE&folder={{galleryFolderId}}&page=1&perPage=24
  body: none
  auth: bearer
}

auth:bearer {
  token: {{secretKey}}
}

tests {
  test("200", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  GET /api/v1/media?q=&kind=&folder=&page=&perPage=: every folder together, or one folder and its subfolders. Run « Arbre des dossiers » first.
}
